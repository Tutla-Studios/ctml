    <div class="w-full bg-slate-800 border border-slate-700 rounded-sm px-1 py-[2px] text-xs text-slate-400" text="position">
      <div class="w-full flex flex-row gap-1 items-start">
        <div class="relative w-8 h-6 bg-slate-700">
          <div class="absolute top-0 right-0 w-2 h-2 bg-rose-500"></div>
          <div class="absolute bottom-0 left-0 w-2 h-2 bg-sky-500"></div>
          <div class="absolute inset-x-0 top-2 h-1 bg-amber-400"></div>
        </div>
        <div class="w-6 h-6 bg-slate-700">
          <div class="relative top-1 left-1 w-4 h-4 bg-amber-500"></div>
        </div>
        <div class="w-6 h-6 bg-slate-700 flex flex-row justify-center items-center">
          <div class="w-3 h-3 bg-emerald-400 rounded-full"></div>
        </div>
      </div>
    </div>

    <div class="w-full bg-slate-800 border border-slate-700 rounded-sm px-1 py-[2px] text-xs text-slate-400" text="sizing">
      <div class="w-1/3 h-1 bg-violet-300"></div>
      <div class="w-1/2 h-1 bg-violet-400 mt-1"></div>
      <div class="w-full h-1 bg-violet-500 mt-1"></div>
      <div class="w-[60px] h-1 bg-violet-600 mt-1"></div>
      <div class="w-full flex flex-row gap-1 items-center mt-1">
        <div class="size-3 bg-violet-200"></div>
        <div class="min-w-8 h-[10px] bg-violet-700"></div>
        <div class="max-w-[40px] text-xs text-slate-300" text="max-w wraps"></div>
      </div>
    </div>

  </div>

  <div class="flex-1 h-full flex flex-col gap-1">

    <div class="w-full bg-slate-800 border border-slate-700 rounded-sm px-1 py-[2px] text-xs text-slate-400" text="padding, margin, box">
      <div class="w-full flex flex-row gap-1 items-start text-xs text-indigo-100">
