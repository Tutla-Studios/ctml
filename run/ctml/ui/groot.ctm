<ctml class="w-full h-full bg-slate-900 text-slate-100 text-shadow p-1 flex flex-row gap-1 overflow-x-hidden overflow-y-auto scrollbar-thumb-slate-500 scrollbar-track-slate-800">

  <div class="flex-1 h-full flex flex-col gap-1">

    <div class="w-full bg-slate-800 border border-slate-600 rounded px-1 py-[2px] text-center text-amber-400 font-bold" text="CraftyTML" draggable>
      <div class="w-full text-center text-slate-400 font-normal text-xs" text="tailwind demo: div, span, table, img and the markdown set"></div>
    </div>

    <div class="w-full bg-slate-800 border border-slate-700 rounded-sm px-1 py-[2px] text-xs text-slate-400" text="font sizes">
      <div class="w-full flex flex-row gap-1 items-end text-sky-300">
        <span class="text-xs" text="xs"></span>
        <span class="text-sm" text="sm"></span>
        <span class="text-base" text="bs"></span>
        <span class="text-lg" text="lg"></span>
        <span class="text-xl" text="xl"></span>
        <span class="text-2xl" text="2x"></span>
      </div>
    </div>

    <div class="w-full bg-slate-800 border border-slate-700 rounded-sm px-1 py-[2px] text-xs text-slate-400" text="font styles">
      <div class="w-full flex flex-row gap-1 text-xs">
        <span class="font-bold text-slate-100" text="bold"></span>
        <span class="italic text-emerald-300" text="ital"></span>
        <span class="underline text-amber-300" text="undr"></span>
        <span class="line-through text-rose-300" text="strk"></span>
        <span class="text-shadow-none text-slate-500" text="flat"></span>
      </div>
    </div>

    <div class="w-full bg-slate-800 border border-slate-700 rounded-sm px-1 py-[2px] text-xs text-slate-400" text="align and leading">
      <div class="w-full border-l-2 border-sky-500 pl-1 text-left text-xs text-slate-200" text="left"></div>
      <div class="w-full border-l-2 border-amber-500 pl-1 text-center text-xs text-slate-200" text="center"></div>
      <div class="w-full border-l-2 border-rose-500 pl-1 text-right text-xs text-slate-200" text="right"></div>
      <div class="w-full leading-6 text-xs text-slate-500" text="leading-6"></div>
    </div>

    <div class="w-full bg-slate-800 border border-slate-700 rounded-sm px-1 py-[2px] text-xs text-slate-400" text="whitespace and raw">
      <div class="w-full h-3 overflow-hidden whitespace-nowrap text-xs bg-slate-700 text-slate-200" text="nowrap, clipped by overflow"></div>
      <div class="w-full text-xs text-cyan-300" >raw child content, no attribute</div>
    </div>

    <div class="w-full bg-slate-800 border border-slate-700 rounded-sm px-1 py-[2px] text-xs text-slate-400" text="opacity, visibility">
      <div class="w-full flex flex-row gap-1 items-center">
        <div class="w-3 h-4 bg-white opacity-100"></div>
        <div class="w-3 h-4 bg-white opacity-75"></div>
        <div class="w-3 h-4 bg-white opacity-50"></div>
        <div class="w-3 h-4 bg-white opacity-25"></div>
        <div class="w-3 h-4 bg-white invisible"></div>
        <div class="w-3 h-4 bg-white hidden"></div>
        <span class="text-xs text-slate-500" text="2 gone"></span>
      </div>
    </div>

  </div>

  <div class="flex-1 h-full flex flex-col gap-1">

    <div class="w-full bg-slate-800 border border-slate-700 rounded-sm px-1 py-[2px] text-xs text-slate-400" text="palette families">
      <div class="w-full flex flex-row">
        <div class="w-[6px] h-3 bg-red-500"></div>
        <div class="w-[6px] h-3 bg-orange-500"></div>
        <div class="w-[6px] h-3 bg-amber-500"></div>
