        <div class="w-[6px] h-3 bg-cyan-500"></div>
        <div class="w-[6px] h-3 bg-sky-500"></div>
        <div class="w-[6px] h-3 bg-blue-500"></div>
        <div class="w-[6px] h-3 bg-indigo-500"></div>
        <div class="w-[6px] h-3 bg-violet-500"></div>
        <div class="w-[6px] h-3 bg-purple-500"></div>
