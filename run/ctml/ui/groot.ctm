        <div class="w-4 h-4 bg-teal-500 rounded-none"></div>
        <div class="w-4 h-4 bg-teal-500 rounded-sm"></div>
        <div class="w-4 h-4 bg-teal-500 rounded"></div>
        <div class="w-4 h-4 bg-teal-500 rounded-md"></div>
        <div class="w-4 h-4 bg-teal-500 rounded-lg"></div>
        <div class="w-4 h-4 bg-teal-500 rounded-full"></div>
      </div>
    </div>

    <div class="w-full bg-slate-800 border border-slate-700 rounded-sm px-1 py-[2px] text-xs text-slate-400" text="justify-content">
      <div class="w-full h-2 flex flex-row justify-start bg-slate-700">
        <div class="w-2 h-2 bg-lime-400"></div>
        <div class="w-2 h-2 bg-lime-600"></div>
      </div>
      <div class="w-full h-2 flex flex-row justify-center bg-slate-600">
        <div class="w-2 h-2 bg-lime-400"></div>
        <div class="w-2 h-2 bg-lime-600"></div>
      </div>
      <div class="w-full h-2 flex flex-row justify-end bg-slate-700">
        <div class="w-2 h-2 bg-lime-400"></div>
        <div class="w-2 h-2 bg-lime-600"></div>
      </div>
      <div class="w-full h-2 flex flex-row justify-between bg-slate-600">
        <div class="w-2 h-2 bg-lime-400"></div>
        <div class="w-2 h-2 bg-lime-600"></div>
      </div>
      <div class="w-full h-2 flex flex-row justify-evenly bg-slate-700">
        <div class="w-2 h-2 bg-lime-400"></div>
        <div class="w-2 h-2 bg-lime-600"></div>
      </div>
      <div class="w-full h-2 flex flex-row justify-around bg-slate-600">
        <div class="w-2 h-2 bg-lime-400"></div>
        <div class="w-2 h-2 bg-lime-600"></div>
      </div>
    </div>

    <div class="w-full bg-slate-800 border border-slate-700 rounded-sm px-1 py-[2px] text-xs text-slate-400" text="align-items, direction">
      <div class="w-full flex flex-row gap-1 items-start">
        <div class="w-6 h-6 flex flex-row items-start gap-1 bg-slate-700">
          <div class="w-2 h-2 bg-fuchsia-400"></div>
          <div class="w-2 h-4 bg-fuchsia-600"></div>
        </div>
        <div class="w-6 h-6 flex flex-row items-center gap-1 bg-slate-700">
          <div class="w-2 h-2 bg-fuchsia-400"></div>
          <div class="w-2 h-4 bg-fuchsia-600"></div>
        </div>
        <div class="w-6 h-6 flex flex-row items-end gap-1 bg-slate-700">
          <div class="w-2 h-2 bg-fuchsia-400"></div>
          <div class="w-2 h-4 bg-fuchsia-600"></div>
        </div>
        <div class="w-6 h-6 flex flex-col gap-1 bg-slate-700 p-1">
          <div class="w-4 h-1 bg-cyan-300"></div>
